# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Optional (defaults shown) ──────────────────────────────────────────────────
# OpenAI model to use for plant identification and care synthesis
OPENAI_MODEL=gpt-4o

# PostgreSQL connection string
# Docker Compose sets this to the 'db' service automatically
DATABASE_URL=postgresql+asyncpg://leaflens:leaflens@localhost:5432/leaflens

# Directory where uploaded images are stored
UPLOAD_DIR=/tmp/leaflens_uploads

# Maximum upload size in MB
MAX_UPLOAD_SIZE_MB=10

# Number of alternative species to return per identification
TOP_K_ALTERNATIVES=5
